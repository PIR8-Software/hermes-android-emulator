#!/usr/bin/env bash
# emu — start/stop/status the Hermes Android emulator
# Usage: emu start | emu stop | emu status

set -euo pipefail
export ANDROID_HOME="$HOME/Android/Sdk"
export PATH="$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$PATH"
AVD="${ANDROID_EMULATOR_AVD:-pixel7pro}"

case "${1:-status}" in
  start)
    if adb devices | grep -q "emulator.*device$"; then
      echo "Emulator already running"
      adb devices -l
      exit 0
    fi
    echo "Starting emulator '$AVD' headless..."
    nohup emulator -avd "$AVD" \
      -no-window -no-audio -no-boot-anim \
      -gpu swiftshader_indirect \
      -memory 2048 -partition-size 4096 \
      -no-snapshot \
      > /tmp/emulator.log 2>&1 &
    echo "PID: $!"
    echo "Waiting for boot (this takes ~60-90s)..."
    adb wait-for-device
    for i in $(seq 1 30); do
      STATE=$(adb shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')
      if [ "$STATE" = "1" ]; then
        echo "Emulator booted!"
        adb devices -l
        exit 0
      fi
      sleep 3
    done
    echo "Timeout waiting for boot. Check: adb devices"
    ;;
  stop)
    echo "Stopping emulator..."
    adb emu kill 2>/dev/null || true
    sleep 2
    if adb devices | grep -q "emulator"; then
      echo "Force killing..."
      pkill -f "emulator.*-avd $AVD" 2>/dev/null || true
    fi
    echo "Stopped."
    ;;
  status)
    echo "=== Devices ==="
    adb devices -l 2>/dev/null || echo "(adb not found or not running)"
    if adb devices | grep -q "emulator.*device$"; then
      echo ""
      echo "=== Emulator Info ==="
      echo "Android: $(adb shell getprop ro.build.version.release 2>/dev/null | tr -d '\r')"
      echo "SDK:     $(adb shell getprop ro.build.version.sdk 2>/dev/null | tr -d '\r')"
      echo "Model:   $(adb shell getprop ro.product.model 2>/dev/null | tr -d '\r')"
      echo "Screen:  $(adb shell wm size 2>/dev/null | grep Physical | tr -d '\r')"
      echo "Density: $(adb shell wm density 2>/dev/null | grep Physical | tr -d '\r')"
      echo "Boot:    $(adb shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')"
    fi
    ;;
  *)
    echo "Usage: emu {start|stop|status}"
    exit 1
    ;;
esac
